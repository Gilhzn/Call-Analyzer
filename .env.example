# ===== Whisper (תמלול) =====
# tiny / base / small / medium / large-v3 / large-v3-turbo
# או מזהה מודל מ-HuggingFace בפורמט CTranslate2, למשל המודל המכוון לעברית:
#   ivrit-ai/whisper-large-v3-turbo-ct2
WHISPER_MODEL=small
# auto / cpu / cuda
WHISPER_DEVICE=auto
# int8 (מהיר וחסכוני ב-CPU) / float16 (ל-GPU) / float32
WHISPER_COMPUTE_TYPE=int8
# טעינת המודל מראש בעליית השרת (true) או בבקשה הראשונה (false)
WHISPER_PRELOAD=false
# 1 = פענוח מהיר (ברירת מחדל, איכות כמעט זהה) | 5 = beam search מדויק ואיטי יותר
WHISPER_BEAM_SIZE=1
# 0 = שימוש בכל ליבות המעבד
WHISPER_CPU_THREADS=0

# ===== האצת ענן חינם — Groq (אופציונלי) =====
# מפתח חינם ללא כרטיס אשראי: https://console.groq.com/keys
# כשהמפתח מוגדר, התמלול והניתוח רצים על שרתי ה-GPU של Groq —
# מהיר ומדויק משמעותית (whisper-large-v3-turbo + מודל 120B).
# שימו לב: במצב זה ההקלטה נשלחת ל-Groq לעיבוד.
GROQ_API_KEY=
GROQ_ASR_MODEL=whisper-large-v3-turbo
GROQ_LLM_MODEL=openai/gpt-oss-120b

# ===== Ollama (ניתוח וסיכום) =====
OLLAMA_BASE_URL=http://localhost:11434
# מודלים מומלצים לעברית: gemma3:4b (ברירת מחדל), aya-expanse:8b (העברית הטובה ביותר), qwen2.5:7b
OLLAMA_MODEL=gemma3:4b
OLLAMA_TIMEOUT_SECONDS=300
OLLAMA_NUM_CTX=8192

# ===== שרת =====
MAX_UPLOAD_MB=200
MAX_CONCURRENT_JOBS=1
# משרות שלא נצרכו נמחקות מהזיכרון אחרי (שניות)
JOB_TTL_SECONDS=600

# ===== ניתוח שיחות ארוכות =====
ANALYSIS_CHUNK_CHARS=6000
ANALYSIS_MAX_CHUNKS=10
